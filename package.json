{
  "name": "ohmyguigs-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Site pessoal estático: HTML5, Tailwind CSS e JavaScript nativo com Web Components.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"tests/*.test.js\"",
    "test:build": "node --test \"tests/build/*.test.js\"",
    "check": "npm test && npm run build && npm run test:build",
    "browser-check": "node scripts/browser-check.mjs",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  }
}
